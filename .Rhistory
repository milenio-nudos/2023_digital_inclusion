raw_2023_clean <- haven::zap_labels(raw_2023)
# Selección de variables numéricas
data_corr <- raw_2023_clean %>%
mutate(across(starts_with("b12"), ~ ifelse(. == 99, NA, .)))%>%
dplyr::select(
algorithmic_awareness,
nse,
genero=a1,
edad=a2,
tipo_zona,
innovative_personality
) %>%
mutate(across(everything(), as.numeric))
# Calcular matriz de correlaciones (usa solo observaciones completas)
cor_matrix <- cor(data_corr, use = "pairwise.complete.obs")
# Paleta de colores bicolor (rojo = negativo, blanco = neutro, azul = positivo)
col_bi <- colorRampPalette(c("#B2182B", "#F7F7F7", "#2166AC"))(200)
# Graficar
corrplot(
cor_matrix,
method = "color",         # mapa de color
type = "upper",           # muestra solo la mitad superior
addCoef.col = "black",    # agrega valores numéricos
tl.col = "black",         # color de etiquetas
tl.srt = 45,              # rotación etiquetas
number.cex = 0.8,         # tamaño de número
col = col_bi,             # paleta de colores bicolor
mar = c(0,0,2,0),
diag = FALSE
)
title("Matriz de correlaciones Sociodemográficos",
line = -1, cex.main = 1.2)
m0 <- lm(algorithmic_awareness ~ tech_operational_skills + tech_informative_skills + tech_social_skills + tech_creative_skills,
data = data_corr)
m0 <- lm(algorithmic_awareness ~ tech_operational_skills + tech_informative_skills + tech_social_skills + tech_creative_skills,
data = data_corr)
