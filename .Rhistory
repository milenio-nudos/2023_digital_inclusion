#Open data
load("~/GitHub/milenio_nudos/2023_digital_inclusion/01_input/02_proc_data/digital_inclusion_2023.RData")
# ---- HOUSEHOLD INCOME ----
# Combine income variables from items g3_1 to g3_10 into a single variable
incomes <- data %>%
dplyr::select(starts_with("g3_")) %>%
mutate_all(as.integer)
data$incomes <- coalesce(
incomes$g3_1, incomes$g3_2, incomes$g3_3, incomes$g3_4,
incomes$g3_5, incomes$g3_6, incomes$g3_7, incomes$g3_8,
incomes$g3_9, incomes$g3_10
)
# ---- SOCIODEMOGRAPHIC VARIABLES ----
data <- data %>%
mutate(
# Gender: 0 = male, 1 = female
a1 = ifelse(gender == 2, 1,
ifelse(gender == 1, 0, NA)),
gender = factor(a1,
levels = c(0, 1),
labels = c("Male", "Female")),
# Type of residence: 1 = urban, 2 = rural
residence = case_when(
tipo_zona == 1 ~ "Urban",
tipo_zona == 2 ~ "Rural",
TRUE ~ NA_character_
),
residence = factor(residence, levels = c("Urban", "Rural")),
# Educational level (recoded into 6 categories)
g7 = case_when(
g7 %in% c(1, 2) ~ 1,     # Incomplete primary
g7 == 3 ~ 2,             # Complete primary
g7 == 4 ~ 3,             # Incomplete high school
g7 == 5 ~ 4,             # Complete high school
g7 %in% c(6, 8) ~ 5,     # Incomplete college
g7 %in% c(7, 9, 10) ~ 6, # College education
TRUE ~ NA_real_
),
education = factor(g7,
levels = 1:6,
labels = c("Incomplete primary",
"Complete primary",
"Incomplete high school",
"Complete high school",
"Incomplete college",
"College education")),
# Household income as ordinal variable (1–9)
income_num = as.numeric(incomes)
)
