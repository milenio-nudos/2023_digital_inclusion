tech_operational_skills = rowMeans(select(., all_of(operational_items)), na.rm = TRUE),
tech_informative_skills = rowMeans(select(., all_of(informative_items)), na.rm = TRUE),
tech_social_skills      = rowMeans(select(., all_of(social_items)), na.rm = TRUE),
