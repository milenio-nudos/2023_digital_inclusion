)
# ---- RELIABILITY CHECK (OPTIONAL) ----
# Cronbach’s alpha for each subscale (recommended for reporting)
library(psych)
alpha_operational <- psych::alpha(data %>% select(all_of(operational_items)))
alpha_informative <- psych::alpha(data %>% select(all_of(informative_items)))
alpha_social      <- psych::alpha(data %>% select(all_of(social_items)))
alpha_creative    <- psych::alpha(data %>% select(all_of(creative_items)))
cat("\nCronbach's alpha coefficients:\n")
cat("Operational skills: ", round(alpha_operational$total$raw_alpha, 2), "\n")
cat("Informative skills: ", round(alpha_informative$total$raw_alpha, 2), "\n")
cat("Social skills: ", round(alpha_social$total$raw_alpha, 2), "\n")
cat("Creative skills: ", round(alpha_creative$total$raw_alpha, 2), "\n")
