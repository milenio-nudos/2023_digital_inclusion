# ---- INCOME VARIABLES ----
# Selecciona columnas de ingresos y reemplaza 99 por NA
income_vars <- data %>%
select(starts_with("g3_")) %>%
mutate(across(everything(), ~ na_if(as.integer(.), 99)))
# Combina todas las columnas en una sola variable "incomes"
data$incomes <- do.call(coalesce, income_vars)
# Opcional: elimina las columnas originales si ya no las necesitas
data <- data %>% select(-starts_with("g3_"))
# ---- SOCIODEMOGRAPHIC VARIABLES ----
data <- data %>%
mutate(
# Gender: 0 = male, 1 = female
a1 = ifelse(a1 == 2, 1,
ifelse(a1 == 1, 0, NA)),
gender = factor(a1,
levels = c(0, 1),
labels = c("Male", "Female")),
# Change age variable name
age = a2,
# Type of residence: 1 = urban, 2 = ral
residence = case_when(
tipo_zona == 1 ~ "Urban",
tipo_zona == 2 ~ "Rural",
TRUE ~ NA_character_
),
residence = factor(residence, levels = c("Urban", "Rural")),
# Educational level (recoded into 6 categories)
g7 = case_when(
g7 %in% c(1, 2) ~ 1,     # Incomplete primary
g7 == 3 ~ 2,             # Complete primary
g7 == 4 ~ 3,             # Incomplete high school
g7 == 5 ~ 4,             # Complete high school
g7 %in% c(6, 8) ~ 5,     # Incomplete college
g7 %in% c(7, 9, 10) ~ 6, # College education
TRUE ~ NA_real_
),
education = factor(g7,
levels = 1:6,
labels = c("Incomplete primary",
"Complete primary",
"Incomplete high school",
"Complete high school",
"Incomplete college",
"College education")),
# Household income as ordinal variable (1–9)
income_num = as.numeric(incomes)
)
