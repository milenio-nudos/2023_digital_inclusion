# ---- ALGORITHMIC AWARENESS INDEX (MEAN SCALE) ----
# Based on items from battery D2 (Algorithmic Media Content Awareness - AMCA)
# 1. Convert all D2 items to numeric
data <- data %>%
mutate(across(starts_with("d2"), as.numeric))%>%
mutate(across(starts_with("d2"), ~ ifelse(. == 99, NA, .)))
# 2. Compute the mean index for algorithmic awareness
#    The index represents the average awareness level across all D2 items
data <- data %>%
mutate(
algorithmic_awareness = rowMeans(select(., starts_with("d2")), na.rm = TRUE)
)
# 3. Normalize to 0–1 range (optional, for comparability with other indices)
normalize <- function(x) (x - min(x, na.rm = TRUE)) /
(max(x, na.rm = TRUE) - min(x, na.rm = TRUE))
data <- data %>%
mutate(
algorithmic_awareness = normalize(algorithmic_awareness)
)
# 4. Reliability check (Cronbach’s alpha)
awareness_items <- names(select(data, starts_with("d2")))
alpha_awareness <- psych::alpha(data %>% select(all_of(awareness_items)))
cat("\nCronbach's alpha coefficient:\n")
cat("Algorithmic awareness: ", round(alpha_awareness$total$raw_alpha, 2), "\n")
# ---- PROCESS SOCIAL MEDIA USE VARIABLES ----
data <- data %>%
# Recode missing values (99 -> NA) for all b12 items
mutate(across(starts_with("b12"), ~ ifelse(. == 99, NA, .))) %>%
# ---- Transform only e2_3_3 (Netflix) ----
mutate(
e2_3_3 = ifelse(e2_3_3 == 99, NA, e2_3_3),
e2_3_3 = case_when(
e2_3_3 %in% c(1, 2) ~ 1,  # Never done + Done 3 months ago
e2_3_3 == 3 ~ 2,          # Once or three per month
e2_3_3 == 4 ~ 3,          # All the weeks
e2_3_3 == 5 ~ 4,          # Once a day or more
e2_3_3 == 6 ~ 5,  # Once a day or more
TRUE ~ NA_real_
)
) %>%
# Rename variables for clarity
dplyr::rename(
yt      = b12_1,
fb      = b12_2,
tw      = b12_3,
ig      = b12_4,
wsp     = b12_5,
tiktok  = b12_6,
netflix = e2_3_3
) %>%
# Ensure all are numeric
mutate(across(everything(), as.numeric))
# ---- Model variables ----
model_vars <- c(
"algorithmic_awareness",
"age", "gender", "education", "incomes", "residence",
"tech_operational_skills", "tech_informative_skills",
"tech_social_skills", "tech_creative_skills",
"yt", "fb", "tw", "ig", "wsp", "tiktok", "netflix"
)
# ---- Descriptive table ----
desc_table <- lapply(model_vars, function(v){
x <- data[[v]]
if(is.numeric(x)){
desc <- paste0(round(mean(x, na.rm=TRUE),2), " (", round(sd(x, na.rm=TRUE),2), ")")
} else {
tab <- table(x, useNA="ifany")
pct <- round(prop.table(tab)*100,1)
desc <- paste0(names(tab), " (", as.vector(tab), ", ", as.vector(pct), "%)", collapse = "; ")
}
data.frame(
Variable = as.character(v),
Type = ifelse(is.numeric(x), "Numeric", "Categorical"),
Description = desc,
N_observed = sum(!is.na(x)),
N_missing = sum(is.na(x)),
Cronbach_alpha = NA,
stringsAsFactors = FALSE
)
}) %>% bind_rows()
# ---- Cronbach's alpha for indices ----
indices_list <- list(
"Algorithmic Awareness" = grep("algorithmic_awareness", names(data), value=TRUE),
"Operational Skills" = operational_items,
"Informative Skills" = informative_items,
"Social Skills" = social_items,
"Creative Skills" = creative_items
)
alpha_table <- lapply(names(indices_list), function(idx_name){
vars <- intersect(indices_list[[idx_name]], names(data))
if(length(vars) > 1){
alpha_val <- round(psych::alpha(data[, vars], check.keys=TRUE)$total$raw_alpha,2)
} else { alpha_val <- NA }
data.frame(
Variable = idx_name,
Type = "Index",
Description = NA,
N_observed = NA,
N_missing = NA,
Cronbach_alpha = alpha_val,
stringsAsFactors = FALSE
)
}) %>% bind_rows()
# ---- Combine descriptive and alpha tables ----
final_table <- bind_rows(desc_table, alpha_table)
# ---- Create flextable for Word ----
ft_final <- flextable(final_table) %>%
autofit() %>%
set_header_labels(
Variable = "Variable",
Type = "Type",
Description = "Description (Mean±SD or categories)",
N_observed = "N Observed",
N_missing = "N Missing",
Cronbach_alpha = "Cronbach's Alpha"
)
# ---- Display table ----
ft_final
# ---- Optionally save to Word ----
# save_as_docx(ft_final, path = "Descriptive_Table.docx")
# ---- CORRELATION MATRIX ----
# Select variables for correlation
corr_vars <- data %>%
select(
algorithmic_awareness,
age,
residence,
gender,
education,
incomes,
tech_operational_skills,
tech_informative_skills,
tech_social_skills,
tech_creative_skills,
yt, fb, tw, ig, wsp, tiktok, netflix
)
# Compute correlations with p-values
corr_test <- Hmisc::rcorr(as.matrix(corr_vars), type = "pearson")
# Extract correlation coefficients and p-values
r <- round(corr_test$r, 2)
p <- corr_test$P
# Combine correlation and p-value into one string
corr_table <- matrix(
paste0(r, "\n(", ifelse(p < 0.001, "<.001", round(p, 3)), ")"),
ncol = ncol(r)
)
colnames(corr_table) <- colnames(r)
rownames(corr_table) <- rownames(r)
# Convert to data frame for printing
corr_table_df <- as.data.frame(corr_table)
# Display with knitr::kable
knitr::kable(
corr_table_df,
caption = "Pearson Correlation Matrix with p-values (in parentheses)",
align = "c"
)
# ---- REGRESSION MODELS ----
# ---- MODEL 1: Demographics only ----
model1 <- lm(
algorithmic_awareness ~ age + gender + education + incomes + residence,
data = data
)
# ---- MODEL 2: Adds Digital Skills ----
model2 <- lm(
algorithmic_awareness ~age + gender + education + incomes + residence +
tech_operational_skills + tech_informative_skills +
tech_social_skills + tech_creative_skills,
data = data
)
# ---- MODEL 3: Full Model (adds social media use) ----
model3 <- lm(
algorithmic_awareness ~ age + gender + education + incomes + residence +
tech_operational_skills + tech_informative_skills +
tech_social_skills + tech_creative_skills +
yt + fb + tw + ig + wsp + tiktok + netflix,
data = data
)
# ---- Apply robust standard errors (HC3) ----
#cov1 <- vcovHC(model1, type = "HC3")
#cov2 <- vcovHC(model2, type = "HC3")
#cov3 <- vcovHC(model3, type = "HC3")
# ---- Display models with variable labels ----
tab_model(
model1, model2, model3,
collapse.se = TRUE,      # muestra errores estándar entre paréntesis
show.ci = FALSE,
show.aic = TRUE,
show.r2 = TRUE,
show.fstat = TRUE,
p.style = "stars",
dv.labels = c(
"Model 1: Demographics",
"Model 2: + Digital Skills",
"Model 3: + Social Media Use"
),
title = "Linear Regression Models Predicting Algorithmic Awareness",
# ---- Variable labels ----
pred.labels = c(
"Intercept",
"Age",
"Gender (ref: Male)",       # ejemplo de categoría de referencia
"Educational level",
"Household Income",
"Residence (ref: Urban)",
"Operational Skills",
"Informative Skills",
"Social Skills",
"Creative Skills",
"YouTube Use",
"Facebook Use",
"Twitter Use",
"Instagram Use",
"WhatsApp Use",
"TikTok Use",
"Netflix Use"
)
)
vif(model3)|>kable()
View(model3)
vif(model3)
# Usa la matriz de correlaciones 'r' que ya calculaste
corrplot(
r,
method = "color",       # Usa color para representar la correlación
type = "upper",         # Muestra solo el triángulo superior
order = "hclust",       # Reordena las variables para agrupar las más correlacionadas
addCoef.col = "black",  # Añade el coeficiente de correlación en negro
tl.col = "black",       # Color del texto de las variables
tl.srt = 45,            # Rota el texto de las variables para que quepa mejor
# Añade p-values como asteriscos de significancia
p.mat = p,
sig.level = 0.05,
insig = "blank"         # Deja en blanco las correlaciones no significativas
)
