# Example item grouping (please adjust names as needed)
operational_items <- c("c3_1", "c3_2", "c3_3", "c3_4")
informative_items <- c("c3_5", "c3_6", "c3_7")
social_items      <- c("c3_8", "c3_9", "c3_10", "c3_11")
creative_items    <- c("c3_12", "c3_13", "c3_14")
# Convert all C3 items to numeric
data <- data %>%
mutate(across(starts_with("c3_"), as.numeric))
# Create mean indices for each digital skill domain
data <- data %>%
mutate(
tech_operational_skills = rowMeans(select(., all_of(operational_items)), na.rm = TRUE),
tech_informative_skills = rowMeans(select(., all_of(informative_items)), na.rm = TRUE),
tech_social_skills      = rowMeans(select(., all_of(social_items)), na.rm = TRUE),
tech_creative_skills    = rowMeans(select(., all_of(creative_items)), na.rm = TRUE)
)
# ---- NORMALIZATION (0–1 SCALE) ----
# Normalize each index to a 0–1 range for comparability
normalize <- function(x) (x - min(x, na.rm = TRUE)) / (max(x, na.rm = TRUE) - min(x, na.rm = TRUE))
